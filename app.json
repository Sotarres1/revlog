{
  "expo": {
    "name": "RevLog",
    "slug": "revlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "revlog",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0D0F12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spencer.revlog",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.spencer.revlog",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0F12"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "RevLog uses your photo library so you can add pictures of your vehicles."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E63946"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce509968-1f73-4c8b-9bb8-da2685455002"
      }
    }
  }
}
